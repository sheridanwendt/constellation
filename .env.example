# ---------------------------------------------------------------------------
# Constellation Phase 1 environment configuration.
#
# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed. scripts/install/05-config.sh will do this copy
# and generate a strong POSTGRES_PASSWORD automatically.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_DB=constellation

POSTGRES_USER=constellation

POSTGRES_PASSWORD=change-me

# Bound to 127.0.0.1 only; change if you need host-network access.
POSTGRES_PORT=5432

POSTGRES_MEM_LIMIT=512m

# --- Qdrant ---
QDRANT_HOST=qdrant

QDRANT_PORT=6333

QDRANT_HTTP_PORT=6333

QDRANT_GRPC_PORT=6334

QDRANT_MEM_LIMIT=1g

# --- NATS ---
NATS_URL=nats://nats:4222

NATS_CLIENT_PORT=4222

NATS_MONITOR_PORT=8222

NATS_MEM_LIMIT=256m

# --- Platform ---
LOG_LEVEL=INFO

# development | production. Phase 1 assumes an isolated, single-host
# deployment; see docs/13-security-model.md and docs/19-service-security.md
# before setting this to production.
CONSTELLATION_ENV=development

# --- Backups ---
# See docs/09-operations.md for the retention policy. The first backup ever
# taken is always kept; these only bound the rest.
BACKUP_RETENTION_COUNT=52

# Percent (1-100) of the total disk hosting this repo. Computed fresh on
# every backup run via `df`, so it scales automatically if you move to
# different/larger hardware.
BACKUP_MAX_TOTAL_PERCENT=10
